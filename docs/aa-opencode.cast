[0.036, "o", "\u001b[3m                           OpenCode models vs Artificial Analysis benchmarks                           \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mModel                     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCreator  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mIntelligence\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mCoding\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mSpeed (tok/s)\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mTTFT (s)\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mGo $/1M\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━━┩\r\n│\u001b[1m \u001b[0m\u001b[1mdeepseek-v4.1-flash       \u001b[0m\u001b[1m \u001b[0m│ DeepSeek  │            — │      — │         212.4 │      0.9 │    $0.3 │\r\n│\u001b[1m \u001b[0m\u001b[1mdeepseek-v4-pro           \u001b[0m\u001b[1m \u001b[0m│ DeepSeek  │         23.1 │      — │          93.5 │      1.8 │    $1.0 │\r\n│\u001b[1m \u001b[0m\u001b[1mglm-5.2                   \u001b[0m\u001b[1m \u001b[0m│ Z AI      │            — │      — │          83.7 │      1.8 │    $2.1 │\r\n│\u001b[1m \u001b[0m\u001b[1mglm-5.3                   \u001b[0m\u001b[1m \u001b[0m│ Z AI      │         31.7 │      — │          85.9 │      1.4 │    $2.1 │\r\n│\u001b[1m \u001b[0m\u001b[1mgrok-4.7                  \u001b[0m\u001b[1m \u001b[0m│ SpaceXAI  │         34.3 │      — │          87.9 │     93.3 │    $3.0 │\r\n│\u001b[1m \u001b[0m\u001b[1mmuse-spark-1.2-contributor\u001b[0m\u001b[1m \u001b[0m│ Meta      │            — │      — │             — │        — │    $0.1 │\r\n│\u001b[1m \u001b[0m\u001b[1mmuse-spark-1.3-contributor\u001b[0m\u001b[1m \u001b[0m│ Meta      │            — │      — │             — │        — │    $0.1 │\r\n│\u001b[1m \u001b[0m\u001b[1mglm-5.