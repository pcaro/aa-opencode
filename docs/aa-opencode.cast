[0.004, "o", "\u001b[3m                            Mejores calidad/precio (precio Go)                            \u001b[0m\r\n┏━━━━━━━━━━━┳━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mCategoría\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1m#\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mModelo                    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mMetric\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mPrecio Go $/1M\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mValue (max 100)\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━╇━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━┩\r\n│\u001b[1m \u001b[0m\u001b[1mWebDev   \u001b[0m\u001b[1m \u001b[0m│ 1 │ muse-spark-1.3-contributor │   1656 │           $0.1 │           100.0 │\r\n│\u001b[1m \u001b[0m\u001b[1mWebDev   \u001b[0m\u001b[1m \u001b[0m│ 2 │ muse-spark-1.2-contributor │   1534 │           $0.1 │            92.6 │\r\n│\u001b[1m \u001b[0m\u001b[1mWebDev   \u001b[0m\u001b[1m \u001b[0m│ 3 │ mimo-v2.6-flash            │   1637 │           $0.2 │            70.6 │\r\n│\u001b[1m \u001b[0m\u001b[1mImágenes \u001b[0m\u001b[1m \u001b[0m│ 1 │ claude-haiku-5-5           │   36.2 │           $0.2 │           100.0 │\r\n│\u001b[1m \u001b[0m\u001b[1mImágenes \u001b[0m\u001b[1m \u001b[0m│ 2 │ mimo-v2.6-flash            │   26.7 │           $0.2 │            84.3 │\r\n│\u001b[1m \u001b[0m\u001b[1mImágenes \u001b[0m\u001b[1m \u001b[0m│ 3 │ gpt-6-luna                 │   27.8 │           $0.2 │            76.8 │\r\n│\u001b[1m \u001b[0m\u001b[1mGeneral  \u001b[0m\u001b[1m \u001b[0m│ 1 │ claude-haiku-5-5           │   36.2 │           $0.2 │           100.0 │\r\n│\u001b[1m \u001b[0m\u001b[1mGeneral  \u001b[0m\u001b[1m \u001b[0m│ 2 │ mimo-v2.6-flash            │   26.7 │           $0.2 │            84.3 │\r\n│\u001b[1m \u001b[0m\u001b[1mGeneral  \u001b[0m\u001b[1m \u001b[0m│ 3 │ gpt-6-luna  