[0.001, "o", "\u001b[3m                  Buenas ofertas Go (vs precio AA)                  \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━┳━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mModelo             \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mPrecio AA $/1M\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mPrecio Go $/1M\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mAhorro %\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━╇━━━━━━━━━━┩\r\n│\u001b[1m \u001b[0m\u001b[1mlongcat-2.0        \u001b[0m\u001b[1m \u001b[0m│           $1.3 │           $0.5 │      60% │\r\n│\u001b[1m \u001b[0m\u001b[1mdeepseek-v4.1-flash\u001b[0m\u001b[1m \u001b[0m│           $0.5 │           $0.3 │      50% │\r\n│\u001b[1m \u001b[0m\u001b[1mdeepseek-v4-pro    \u001b[0m\u001b[1m \u001b[0m│           $2.0 │           $1.0 │      50% │\r\n└─────────────────────┴────────────────┴────────────────┴──────────┘\r\n"]
[0.002, "o", "\u001b[1;2;36m3\u001b[0m\u001b[2m \u001b[0m\u001b[1;2;35mmodelo\u001b[0m\u001b[1;2m(\u001b[0m\u001b[2ms\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m sin datos en Artificial Analysis.\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mDatos: \u001b[0m\u001b[2;4;94mhttps://artificialanalysis.ai/\u001b[0m\u001b[2m \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2matribución requerida\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m. Intelligence Index v5. Precio Go = blended \u001b[0m\u001b[1;2;92m3:1\u001b[0m\u001b[2m por 1M \u001b[0m\r\n\u001b[2mtokens. Value: \u001b[0m\u001b[1;2;36m100\u001b[0m\u001b[2m = mejor de su categoría \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mmétrica ÷ precio Go\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m. Ahorro = \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mprecio AA − precio Go\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m ÷ precio AA.\u001b[0m\r\n"]
[0.001, "o", "\u001b[2mArena: LMArena \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mlmarena-ai/leaderboard-dataset, CC-BY-\u001b[0m\u001b[1;2;36m4.0\u001b[0m\u001b[1;2m)\u001b[0m\u001b[2m. Elo no comparable entre tableros. Agent = score centrado en \u001b[0m\r\n\u001b[1;2;36m0\u001b[0m\u001b[2m, no un porcentaje.\u001b[0m\r\n"]
[0.042, "x", "0"]
